#include <winres.h>

// 1. 程式圖示 (若無 custom.ico 可將此行註解掉)
//IDI_APPLICATION ICON "app.ico"

// 2. 版本與元資料資訊
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 000004b0 代表 Language: Neutral, Codepage: Unicode
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName",      "lkh"
            VALUE "FileDescription",  "Window TopMost & Transparency Utility"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "overlay.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2026. All rights reserved."
            VALUE "OriginalFilename", "overlay.exe"
            VALUE "ProductName",      "Window Overlay Tool"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        // 指定語言為 Language Neutral (0x0000), Unicode Codepage (1200 / 0x04b0)
        VALUE "Translation", 0x0000, 0x04b0
    END
END
